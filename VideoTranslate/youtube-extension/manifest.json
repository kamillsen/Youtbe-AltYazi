{
  "manifest_version": 3,
  "name": "YouTube Subtitle Translator",
  "version": "1.0",
  "description": "YouTube videolarına çevirili altyazı ve Türkçe ses desteği ekler.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Subtitle Translator"
  }
}
